{
  "source_version": "v1.2",
  "lab_url": "https://storage.googleapis.com/soilspec4gg-public/ossl_soillab_L1_v1.2.csv.gz",
  "mir_url": "https://storage.googleapis.com/soilspec4gg-public/ossl_mir_L0_v1.2.csv.gz",
  "join_columns": [
    "dataset.code_ascii_txt",
    "id.layer_uuid_txt"
  ],
  "selection": "preserved legacy 300-sample diversity order, then greedy spectral/target diversity extension to 1000",
  "candidate_count": 2400,
  "n_samples": 1000,
  "n_features": 1701,
  "grid_cm-1": [
    600.0,
    4000.0,
    2.0
  ],
  "targets": [
    {
      "code": "N",
      "column": "n.tot_usda.a623_w.pct",
      "label": "Nitrogen total",
      "method": "USDA a623 (NCS/dry combustion)",
      "unit": "% berat",
      "transform": "log1p",
      "color": "#168657"
    },
    {
      "code": "P",
      "column": "p.ext_usda.a274_mg.kg",
      "label": "Fosfor tersedia",
      "method": "USDA a274 (Olsen NaHCO3)",
      "unit": "mg/kg",
      "transform": "log1p",
      "color": "#C06C00"
    },
    {
      "code": "K",
      "column": "k.ext_usda.a725_cmolc.kg",
      "label": "Kalium dapat ditukar",
      "method": "USDA a725 (NH4OAc pH 7)",
      "unit": "cmolc/kg",
      "transform": "log1p",
      "color": "#6D48C7"
    }
  ]
}